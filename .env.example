# API URL for Frontend (apps/web)
# For local browser testing on your laptop:
VITE_API_URL=http://localhost:5000

# For testing from your Tecno Android phone on the same Wi-Fi:
# Replace 192.168.x.x with your laptop's Wi-Fi IP address (run `ip a` or `hostname -I` on Linux):
# VITE_API_URL=http://192.168.1.100:5000

# Flask API Configuration (apps/api)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True
MODEL_PATH=../../models/crop_model.tflite
